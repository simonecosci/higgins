# Copia questo file in .env e riempi SOLO il provider che vuoi usare.
# .env non va in git (è già in .gitignore).
#
# Nessuna di queste chiavi è obbligatoria: senza nessuna configurata, featured.py
# lo dice chiaramente e non genera copertine — publish.py pubblica comunque il testo,
# senza immagine. Vedi il README per il confronto fra i provider.

# Hugging Face — FLUX.1-schnell. Token gratuito, nessuna carta.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Cloudflare Workers AI — stesso modello. 10.000 neuroni/giorno gratis, nessuna carta.
# https://dash.cloudflare.com/profile/api-tokens (account ID nella dashboard)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Google Gemini — gemini-2.5-flash-image. Richiede fatturazione attiva sul progetto
# AI Studio: sul piano gratuito i modelli immagine rispondono 429.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
