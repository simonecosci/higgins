# Copy this file to .env and fill in ONLY the provider you want to use.
# .env must not go in git (it's already in .gitignore).
#
# None of these keys is required: with none configured, featured.py says so plainly
# and generates no covers — publish.py publishes the text anyway, without an image.
# See the README for a comparison of the providers.

# Hugging Face — FLUX.1-schnell. Free token, no credit card.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Cloudflare Workers AI — same model. 10,000 free neurons/day, no credit card.
# https://dash.cloudflare.com/profile/api-tokens (account ID in the dashboard)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Google Gemini — gemini-2.5-flash-image. Requires billing enabled on the AI Studio
# project: on the free plan the image models answer 429.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
